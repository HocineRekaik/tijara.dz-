# Firebase config — copy values from your Firebase console (Project settings -> General).
# These are public keys, safe to embed, but must match your Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API base URL.
# Dev: leave empty (Vite proxies /api to http://localhost:5000).
# Production: https://your-backend-name.onrender.com (no trailing slash).
VITE_API_URL=
