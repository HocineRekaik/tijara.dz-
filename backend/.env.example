PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slash).
# For production, add your Vercel frontend URL, e.g.:
# CORS_ORIGIN=https://tijara-dz.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# OpenAI - powers the AI Assistant (/api/ai-agent).
# Without it the backend falls back to a rule-based extractor.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini

# Gemini - powers the connection test endpoint (/api/gemini-test).
# Required to test the AI connection. Stored ONLY in the backend .env,
# never in the frontend and never committed to GitHub.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Firestore (read-only) - powers the AI agent tools (/api/ai-agent).
# Same values as the frontend VITE_FIREBASE_PROJECT_ID / VITE_FIREBASE_API_KEY.
# The backend only ever reads approved stores through these tools (rules restrict
# access to status == "approved"). Never use a Firebase service account here.
FIREBASE_PROJECT_ID=tijara-dz-8
FIREBASE_API_KEY=your_firebase_web_api_key

# Image upload provider (optional).
# Priority: imgbb -> Cloudinary -> catbox.moe (keyless fallback).
# IMGBB_API_KEY=your_imgbb_free_api_key
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
